{
  "id" : "codex",
  "name" : "Codex CLI",
  "command" : "codex",
  "args" : ["-c", "notify=[\"{scope_hook}\",\"turn.ended\",\"--stdin\"]"],
  "env" : {},
  "context" : { "file" : "AGENTS.md", "mode" : "file" },
  "resume" : ["codex", "-c", "notify=[\"{scope_hook}\",\"turn.ended\",\"--stdin\"]", "resume", "{resume_id}"],
  "headless" : ["codex", "exec", "{prompt}"],
  "prompt" : ["{prompt}"],
  "adapter" : { "kind" : "codex-notify" },
  "icon" : "cpu",
  "builtin" : true,
  "version" : 2
}
