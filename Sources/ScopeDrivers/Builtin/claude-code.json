{
  "id": "claude-code",
  "name": "Claude Code",
  "command": "claude",
  "args": [],
  "env": {
    "CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD": "1"
  },
  "context": {
    "file": "CLAUDE.md",
    "mode": "generate"
  },
  "resume": [
    "claude",
    "--resume",
    "{resume_id}"
  ],
  "headless": [
    "claude",
    "-p",
    "{prompt}",
    "--output-format",
    "json"
  ],
  "headlessLight": [
    "claude",
    "-p",
    "{prompt}",
    "--output-format",
    "json",
    "--model",
    "haiku",
    "--tools",
    "Bash",
    "--setting-sources",
    "",
    "--strict-mcp-config",
    "--no-session-persistence",
    "--allowedTools",
    "Bash(gh pr view:*),Bash(gh pr list:*),Bash(gh repo view:*),Bash(git branch:*),Bash(git log:*)"
  ],
  "headlessAssist": [
    "claude",
    "-p",
    "{prompt}",
    "--output-format",
    "json",
    "--model",
    "haiku",
    "--tools",
    "",
    "--setting-sources",
    "",
    "--strict-mcp-config",
    "--no-session-persistence"
  ],
  "prompt": [
    "{prompt}"
  ],
  "addDir": [
    "--add-dir",
    "{dir}"
  ],
  "modelArgs": [
    "--model",
    "{model}"
  ],
  "models": [
    "claude-fable-5-1",
    "claude-opus-5-5",
    "claude-sonnet-5-5",
    "claude-haiku-5-5"
  ],
  "adapter": {
    "kind": "claude-hooks"
  },
  "icon": "asterisk",
  "builtin": true,
  "version": 8
}
